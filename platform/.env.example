# ─────────────────────────────────────────────────────────────────────────────
# E-Commerce Data Platform — Sample Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Schema used by dbt for Gold / mart tables
DWH_SCHEMA=olist_dwh

# ── Data paths ────────────────────────────────────────────────────────────────
DATASETS_PATH=../Datasets
DATA_BASE_PATH=./data
RAW_PATH=./data/raw
BRONZE_PATH=./data/bronze
SILVER_PATH=./data/silver
GOLD_PATH=./data/gold

# ── PySpark ───────────────────────────────────────────────────────────────────
SPARK_MASTER=local[*]
SPARK_APP_NAME=EcommerceDataPlatform
# Number of shuffle partitions (keep low for this dataset size)
SPARK_SHUFFLE_PARTITIONS=8

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:changeme@localhost/airflow
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here
AIRFLOW_PROJ_DIR=.
